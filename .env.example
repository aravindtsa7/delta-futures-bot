# Copy to .env (same folder) and fill in. .env is read by config.py (prefix DELTA_).
# Delta India DEMO (testnet) account keys: create them in the demo account -> API Keys. Demo keys only work
# against the India testnet API (cdn-ind.testnet.deltaex.org). Never put live keys here
# unless you really intend live trading.
DELTA_TESTNET_API_KEY=
DELTA_TESTNET_API_SECRET=

# LIVE (real money) — Delta Exchange India production keys. Un-prefixed or DELTA_-prefixed names both work.
# Manual live orders need all three of: MODE=live, LIVE_TRADING_ENABLED=true, the key + secret below,
# plus typing LIVE in the Manual Trade tab. The 24/7 AUTO-BOT additionally needs AUTO_BOT_LIVE_ENABLED=true
# (its strategies failed the Step 4B screen — leave it off unless you mean it).
# MODE=live
# LIVE_TRADING_ENABLED=true
# DELTA_API_KEY=
# DELTA_API_SECRET=
# AUTO_BOT_LIVE_ENABLED=false

# paper (default) | testnet | live
# DELTA_EXECUTION_MODE=paper

# Telegram alerts (optional). Create a bot with @BotFather -> token; send the bot a message, then read
# your chat id from https://api.telegram.org/bot<token>/getUpdates  ("chat":{"id":...}).
# Without these, alerts are logged locally as dry_run_no_credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
